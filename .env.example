# Supabase — project settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: only needed by `npm run verify:supabase` (developer test account).
# E2E_EMAIL=akun-developer@contoh.com
# E2E_PASSWORD=password-akun-uji

# Optional: only needed to push migrations with the Supabase CLI. Keep these out of
# the browser: never prefix them with VITE_ and never commit `.env`.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=

# Branding (optional overrides; defaults live in src/config/brand.ts)
VITE_GAME_NAME=Lentera
VITE_GAME_TAGLINE=Petualangan belajar yang seru
VITE_GAME_VERSION=0.1.0
VITE_SUPPORT_URL=

# Public site URL used for auth email redirects. Leave empty to use the current origin.
VITE_APP_URL=
