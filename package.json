{
  "name": "lentera",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lentera — platform game edukasi 2D berbasis web.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/lentera/ && node scripts/pages-fallback.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "test:sql": "node scripts/test-sql.mjs",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "verify:admin-deploy": "node --env-file=.env scripts/verify-admin-deploy.mjs",
    "verify:admin-browser": "node --env-file=.env scripts/verify-admin-browser.mjs",
    "verify:admin-deep": "node --env-file=.env scripts/verify-admin-deep.mjs",
    "verify:auto-levels": "node --env-file=.env scripts/verify-auto-levels.mjs",
    "setup:supabase": "node scripts/setup-supabase.mjs",
    "db:apply-catalog-fix": "node scripts/apply-catalog-fix.mjs",
    "seed:build": "tsx scripts/generate-curriculum-sql.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.2.8",
    "@supabase/supabase-js": "2.119.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
